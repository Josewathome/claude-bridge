# claude-bridge configuration. Copy to .env and fill in:
#     cp .env.example .env && chmod 600 .env
#
# Format rules: one KEY=value per line, no quotes, no inline comments.
# (run.sh sources this file, but toggle.py and test_client.py parse it by hand and
# would keep quote characters as part of the value.)

# REQUIRED. Shared secret callers must send in the X-Gateway-Api-Key header.
# The gateway refuses to start while this is empty. Generate one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=

# Optional. Interface to bind. Default 127.0.0.1 (this machine only). To let other
# machines or containers connect, set the specific interface address here rather than
# 0.0.0.0, and firewall the port. See "Security considerations" in README.md.
GATEWAY_HOST=127.0.0.1

# Optional. TCP port. Default 8787.
GATEWAY_PORT=8787

# Optional. Model used when a /chat request does not specify one.
# Default (if unset): claude-sonnet-5
# BRIDGE_DEFAULT_MODEL=claude-sonnet-5
