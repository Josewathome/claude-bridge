# systemd *user* unit for claude-bridge.
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/claude-bridge.service.example ~/.config/systemd/user/claude-bridge.service
#   # edit the two paths and the --host/--port below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now claude-bridge
# To keep it running when you are logged out: loginctl enable-linger "$USER"
[Unit]
Description=claude-bridge - local Claude CLI gateway (PoC)
After=default.target
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=/path/to/claude-bridge
EnvironmentFile=/path/to/claude-bridge/.env
# Keep --host/--port in line with GATEWAY_HOST/GATEWAY_PORT in .env (clients such as
# toggle.py read those values from .env, but systemd does not apply them here).
ExecStart=/path/to/claude-bridge/venv/bin/uvicorn gateway:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
